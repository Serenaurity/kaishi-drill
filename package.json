{
  "name": "kaishi-drill",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "fixture:apkg": "tsx tests/fixtures/write-synthetic-package.mts",
    "test:e2e": "npm run fixture:apkg && npm run build && playwright test",
    "test:e2e:ui": "npm run fixture:apkg && npm run build && playwright test --ui"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.11",
    "dexie": "4.2.1",
    "dompurify": "3.4.14",
    "fzstd": "0.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "sql.js": "1.13.0",
    "ts-fsrs": "5.2.3"
  },
  "devDependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.0.2",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.2",
    "jsdom": "26.1.0",
    "sharp": "0.35.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
